# Optional: add extra public Are.na channels at deploy time.
# These are merged with the curated list in src/config/channels.ts.
ARENA_CHANNEL_SLUGS=sonic-diversity-zewocbw6otq,dj-mixes-i-have-enjoyed,dj-mixes

ARENA_SITE_TITLE=Taste Genealogy
ARENA_SITE_DESCRIPTION=A living map of music references, DJ mixes, scenes, atmospheres, and sonic fingerprints.

# Public canonical site URL used for Open Graph/Twitter share cards.
ARENA_SITE_URL=https://www.taste-genealogy.site

# Optional: PlayHTML realtime presence/cursors host.
# Required for anonymous live cursors and the signal count pill.
NEXT_PUBLIC_PLAYHTML_HOST=https://your-playhtml-host.example.com

# Optional: Are.na personal access token. Without it every build fetches as the
# guest tier (30 requests/minute) and gets rate-limited; a token raises the
# limit (120/min for free). Create one at https://www.are.na/settings/tokens.
# ARENA_ACCESS_TOKEN=

# Optional: render one public Are.na root channel instead of the curated list.
# ARENA_CHANNEL_SLUG=sonic-diversity-zewocbw6otq
